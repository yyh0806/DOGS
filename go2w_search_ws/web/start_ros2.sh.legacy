#!/usr/bin/env bash
# ⚠️ 已退役 (阶段A: web 通信层上移 NX)。保留作 PC fallback / 历史参考, 勿再使用。
# 阶段A 起, PC 端改用: bash web/start_pc_browser.sh  (web 服务由 NX 的 go2w-web.service 提供)
# 本脚本在 PC 起 go2w_humble 容器 + ros_to_json 桥 + panel.py, 这条链路已被 NX 本机 web 替代。
# ====================================================================
# Go2W 真链路一键启动 (笔记本侧)
#
# 前置条件:
#   1. 载荷NX 在线 (192.168.43.41), 上跑 nx_sensor_node (读狗SDK发ROS2话题)
#   2. 狗主控在线, NX 能读到狗数据
#
# 本脚本在笔记本上启动:
#   - Docker Humble 容器 (订阅NX的ROS2话题)
#   - ros_to_json 桥接 (容器内, 把狗数据写成 dog_state.json)
#   - panel.py (宿主机, 读JSON + 跑Web前端, ROS2模式)
#
# 用法:
#   ./web/start_ros2.sh          # 启动
#   然后浏览器开 http://localhost:8000

set -e
cd "$(dirname "$0")/.."

echo "===== 1. 确认载荷NX在线 ====="
if ! ping -c1 -W2 192.168.43.41 >/dev/null 2>&1; then
    echo "❌ 载荷NX (192.168.43.41) 不可达, 请检查NX是否开机连热点"
    exit 1
fi
echo "✅ NX在线"

echo ""
echo "===== 2. 启动 Docker Humble 容器 ====="
if ! docker ps --format '{{.Names}}' | grep -qx go2w_humble; then
    docker run -dit --name go2w_humble --net=host --privileged \
        -e ROS_DOMAIN_ID=0 -e RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
        -v "$(pwd):/workspace:rw" --workdir /workspace \
        osrf/ros:humble-desktop-full bash
    echo "✅ 容器已创建"
else
    echo "✅ 容器已在运行"
fi

echo ""
echo "===== 3. 启动 ros_to_json 桥接 (容器内) ====="
docker exec go2w_humble bash -c 'pgrep -f ros_to_json >/dev/null && { echo "已在运行"; exit 0; }; source /opt/ros/humble/setup.bash; nohup python3 /workspace/web/ros_to_json.py > /tmp/ros2json.log 2>&1 &'
sleep 3
if docker exec go2w_humble test -f /workspace/web/dog_state.json; then
    echo "✅ 桥接就绪, dog_state.json 生成中"
else
    echo "⚠️ 桥接可能未就绪, 检查: docker exec go2w_humble cat /tmp/ros2json.log"
fi

echo ""
echo "===== 4. 启动 panel.py (ROS2模式) ====="
pkill -f "panel.py" 2>/dev/null || true
sleep 1
GO2W_USE_ROS2=1 GO2W_NO_ROBOT=1 python3 web/panel.py &
PANEL_PID=$!
echo "✅ panel.py 启动 PID=$PANEL_PID (ROS2模式, 读真狗数据)"

echo ""
echo "================================================"
echo "  🎉 系统已启动!"
echo "  浏览器打开: http://localhost:8000"
echo "  (地图应显示真狗位姿 + 雷达扫描点 + yaw朝向)"
echo ""
echo "  停止: kill $PANEL_PID  或  pkill -f panel.py"
echo "================================================"
wait $PANEL_PID
