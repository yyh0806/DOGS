<?xml version="1.0"?>
<!-- Task4: Task1 base + planar_move + ray sensor (点云源, 替代 Livox).
     ray sensor 发 PointCloud2 /livox/lidar → pointcloud_to_laserscan → /scan (Nav2 costmap). -->
<robot name="go2_sim_nav">
  <link name="base_footprint">
    <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  <link name="base_link">
    <inertial><mass value="6.0"/><origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.06" ixy="0" ixz="0" iyy="0.10" iyz="0" izz="0.13"/></inertial>
    <visual name="v"><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.40 0.20 0.10"/></geometry>
      <material name="grey"><color rgba="0.3 0.3 0.3 1.0"/></material></visual>
    <collision name="c"><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.40 0.20 0.10"/></geometry></collision>
  </link>
  <!-- Livox/mid360 mount frame -->
  <link name="livox_frame">
    <inertial><mass value="0.1"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="livox_joint" type="fixed">
    <parent link="base_link"/><child link="livox_frame"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>
  <!-- planar_move (Task1, /cmd_vel, /odom_planar) -->
  <gazebo>
    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <commandTopic>/cmd_vel</commandTopic>
      <bodyName>base_link</bodyName>
      <odometryTopic>/odom_planar</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <updateRate>50.0</updateRate>
    </plugin>
  </gazebo>
  <!-- ray sensor (Task4 点云源): PointCloud2 → /livox/lidar -->
  <gazebo reference="livox_frame">
    <sensor type="ray" name="livox_lidar">
      <ray>
        <scan><horizontal><samples>720</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.1</min><max>30.0</max><resolution>0.02</resolution></range>
      </ray>
      <plugin name="block_laser" filename="libgazebo_ros_block_laser.so">
        <topicName>/livox/lidar</topicName>
        <frameName>livox_frame</frameName>
        <update_rate>10</update_rate>
        <gaussianNoise>0.01</gaussianNoise>
      </plugin>
    </sensor>
  </gazebo>
</robot>
