[Unit]
Description=Go2W Nav2 costmap bridge for Panel obstacle overlay
Wants=network-online.target
After=network-online.target
PartOf=go2w-slam-nav.service

[Service]
Type=simple
User=nx
WorkingDirectory=/home/nx/go2w/current/payload
Environment=HOME=/home/nx
EnvironmentFile=-/etc/go2w/release.env
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=ROS_DOMAIN_ID=0
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/home/nx/go2w/current/payload/docker/fastdds_udp.xml
ExecStartPre=/usr/bin/rm -f /tmp/costmap_lite.json
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/nx/go2w/current/payload/install/setup.bash && exec python3 -u /home/nx/go2w/current/payload/web/costmap_bridge.py'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
