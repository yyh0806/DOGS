+        azimuth_index = std::max(0, std::min(azimuth_bins - 1, azimuth_index));
+        // z/r is monotonic with elevation angle and avoids a second atan2.
+        const float elevation_unit = std::max(
+            -1.0F, std::min(1.0F, point.z / std::sqrt(range_sq)));
+        int elevation_index = static_cast<int>(
+            (elevation_unit + 1.0F) * 0.5F * elevation_bins);
+        elevation_index = std::max(
+            0, std::min(elevation_bins - 1, elevation_index));
+        const int cell = azimuth_index * elevation_bins + elevation_index;
+        if (range_sq < selected_range_sq[cell]) {
+            selected_range_sq[cell] = range_sq;
+            selected[cell] = source_index;
+        }
+    }
+    const int size = static_cast<int>(std::count_if(
+        selected.begin(), selected.end(), [](int index) {return index >= 0;}));
     PointCloudXYZI::Ptr laserCloudIMUBody(new PointCloudXYZI(size, 1));
 
