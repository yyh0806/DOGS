@@ -562,17 +562,49 @@ void publish_frame_body(rclcpp::Publisher<sensor_msgs::msg::PointCloud2>::SharedPtr pubLaserCloudFull_body)
     // Obstacle navigation needs angular coverage, not every deskewed return.
     // Bound DDS serialization and UDP loopback traffic so adding Nav2's
     // participants cannot push the pose estimator seconds behind real time.
-    constexpr int max_body_cloud_points = 3000;
+    // angular_stratified_body_cloud: preserve directions and vertical layers
+    // instead of taking a fixed index stride through Livox's deterministic
+    // scan pattern (which left entire LaserScan sectors empty).
+    constexpr int azimuth_bins = 360;
+    constexpr int elevation_bins = 8;
+    constexpr int max_body_cloud_points = azimuth_bins * elevation_bins;
     const int source_size = feats_undistort->points.size();
-    const int stride = std::max(
-        1, (source_size + max_body_cloud_points - 1) / max_body_cloud_points);
-    const int size = (source_size + stride - 1) / stride;
+    std::vector<int> selected(max_body_cloud_points, -1);
+    std::vector<float> selected_range_sq(
+        max_body_cloud_points, std::numeric_limits<float>::infinity());
+    for (int source_index = 0; source_index < source_size; ++source_index)
+    {
+        const auto & point = feats_undistort->points[source_index];
+        const float horizontal = std::hypot(point.x, point.y);
+        const float range_sq = horizontal * horizontal + point.z * point.z;
+        if (!std::isfinite(range_sq) || range_sq <= 0.0F) continue;
+        const float azimuth = std::atan2(point.y, point.x);
+        int azimuth_index = static_cast<int>(
+            (azimuth + static_cast<float>(M_PI)) * azimuth_bins /
