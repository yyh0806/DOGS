[Unit]
Description=Go2W stable Sport lease gateway
After=network-online.target
Wants=network-online.target
Before=go2w-motion.service

[Service]
Type=simple
User=nx
Environment=LD_LIBRARY_PATH=/home/nx/CycloneDDS/lib
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=ROS_DOMAIN_ID=0
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/home/nx/go2w/current/payload/docker/fastdds_udp.xml
Environment=GO2W_RELEASE_ID=development
Environment=DOG_INTERFACE=enxc8a362616c4c
Environment=GO2W_SPORT_GATEWAY_SOCKET=/run/go2w-sport-gateway/sport.sock
Environment=GO2W_GATEWAY_EVENT_LOG=/home/nx/go2w/safety-events/gateway.jsonl
EnvironmentFile=-/etc/go2w/release.env
EnvironmentFile=-/etc/go2w/hardware.env
RuntimeDirectory=go2w-sport-gateway
RuntimeDirectoryMode=0750
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do [ "$(cat "/sys/class/net/${DOG_INTERFACE}/operstate" 2>/dev/null)" = "up" ] && ping -c 1 -W 1 192.168.123.161 >/dev/null 2>&1 && exit 0; sleep 1; done; echo "[wait-dog] ${DOG_INTERFACE} link/controller 161 not ready; gateway remains stopped" >&2; exit 1'
ExecStart=/bin/bash -c 'exec python3 -u /home/nx/go2w/current/payload/src/go2w_bridge/go2w_bridge/nx_sport_gateway.py'
WorkingDirectory=/home/nx/go2w/current/payload
Restart=always
RestartSec=0.2
KillSignal=SIGINT
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
